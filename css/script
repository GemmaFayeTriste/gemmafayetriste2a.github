function tick(){
const now=new Date();document.getElementById('clock').textContent=now.toLocaleTimeString('en-PH',{timeZone:'Asia/Manila',hour12:true});document.getElementById('date').textContent=now.toLocaleDateString('en-PH',{timeZone:'Asia/Manila',month:'long',day:'numeric',year:'numeric'});document.getElementById('day').textContent=now.toLocaleDateString('en-PH',{timeZone:'Asia/Manila',weekday:'long'})+" • Bambang";}setInterval(tick,1000);tick();
let isDark=localStorage.getItem('gemmaTheme')==='dark';
function applyTheme(){document.body.classList.toggle('dark',isDark);document.getElementById('themeStatus').textContent=isDark?'🌙 Dark Purple':'💜 Pink Light';document.getElementById('themeBtn').textContent=isDark?'☀️ Light':'🌙 Dark';}function toggleTheme(){isDark=!isDark;localStorage.setItem('gemmaTheme',isDark?'dark':'light');applyTheme();}applyTheme();
const fileInput=document.getElementById('fileInput');
const myPhoto=document.getElementById('myPhoto');
const savedPhoto=localStorage.getItem('gemmaPhoto');if(savedPhoto) myPhoto.src=savedPhoto;
fileInput.addEventListener('change',function(e){const file=e.target.files[0];if(!file) return;const reader=new FileReader();reader.onload=function(ev){myPhoto.src=ev.target.result;localStorage.setItem('gemmaPhoto',ev.target.result);alert('💖 Photo saved! ✨');};reader.readAsDataURL(file);});
function removePhoto(){localStorage.removeItem('gemmaPhoto');myPhoto.src="https://i.pravatar.cc/200?img=32";alert('Photo removed 🗑️');}
